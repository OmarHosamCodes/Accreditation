{
  "name": "accreditation",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --parallel --filter @accreditation/web --filter @accreditation/server dev",
    "dev:web": "bun --filter @accreditation/web dev",
    "dev:server": "bun --filter @accreditation/server dev",
    "dev:db": "docker compose up -d",
    "start": "bun --filter @accreditation/server start",
    "build": "bun --filter @accreditation/web build && bun --filter @accreditation/server build",
    "test": "bun test",
    "typecheck": "bun --filter @accreditation/shared typecheck && bun --filter @accreditation/server typecheck && bun --filter @accreditation/web typecheck",
    "check": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.0"
  }
}
