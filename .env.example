# Local Postgres (recommended for dev). Start with: bun run dev:db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/accreditation

# Optional override when DATABASE_URL points at Railway's private network (railway.internal)
# LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/accreditation

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output
BETTER_AUTH_URL=http://localhost:3000

# Seed-only admin account (created on first startup when no users exist)
ADMIN_EMAIL=roaster@accreditation.io
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=roaster

# Chrome extension origin for Better Auth trustedOrigins (after loading unpacked extension)
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Web app: extension ID for connect handoff page messaging
VITE_EXTENSION_ID=YOUR_EXTENSION_ID

# Server port (default: 3000)
PORT=3000

# Set to production in deploy environments
NODE_ENV=development
